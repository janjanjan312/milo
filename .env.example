# DashScope (Alibaba Cloud) - used for ASR and Qwen models
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Volcengine ARK - used for text generation
ARK_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_ARK_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Provider config
VITE_TEXT_PROVIDER=ark
VITE_VISION_PROVIDER=qwen
VITE_QWEN_TEXT_MODEL=qwen-flash
